# Создайте .gitignore
echo "# Dependencies
node_modules/
package-lock.json

# Build outputs
dist/
build/
*.log

# Environment files
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Backend
volleyball-backend/volleyball-backend
